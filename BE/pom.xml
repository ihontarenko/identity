<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.2</version>
        <relativePath/>
    </parent>

    <groupId>net.innoventa</groupId>
    <artifactId>identity-api</artifactId>
    <version>0.1.0</version>
    <name>Innoventa Identity</name>
    <description>Centralized OAuth2 / OpenID Connect authorization server for Innoventa and Moneta</description>

    <properties>
        <java.version>21</java.version>
        <lombok.version>1.18.32</lombok.version>
        <springdoc.version>2.5.0</springdoc.version>
        <testcontainers.version>1.19.8</testcontainers.version>
        <!-- ⚠️ One version for every jMouse artifact, and it has to stay that way: jmouse-access-el
             parses the policy document with jmouse-el's parser and is built against that exact
             build. A mismatched pair resolves, starts, and dies on the first policy read.

             ⚠️ These jars are compiled against Spring Boot 4 while this service is on 3.3.2, and
             that is deliberate rather than overlooked — the library goes out of its way to work on
             both. AccessFlywayAutoConfiguration orders itself against Boot's Flyway initializer by
             BEAN NAME because the type moved package between the two majors, and
             AccessJpaAutoConfiguration lists BOTH majors' HibernateJpaAutoConfiguration by name in
             its `afterName`. Nothing here imports a Boot 4 type. Identity's own parent still
             manages every Spring artifact, so the transitive spring-boot-* pins in those poms do
             not win. -->
        <jmouse.version>1.0.0-b20260802</jmouse.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- Web / Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Security / OAuth2 Authorization Server -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-authorization-server</artifactId>
        </dependency>
        <!-- Identity is simultaneously an OAuth2 CLIENT to Google/GitHub (this dependency) and an
             OAuth2 AUTHORIZATION SERVER to Innoventa/Moneta (the dependency above) — two
             separate roles on two separate SecurityFilterChains, see SecurityConfiguration. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>

        <!-- Data / JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Database drivers — MySQL is the default, PostgreSQL the opt-in `postgresql` profile. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Authorization — for Identity's OWN screens, and for nothing else.
             ⚠️ "Identity is centralized here; authorization is not" still holds. What arrives with
             these jars gates who may raise, disable or delete an ACCOUNT, and who may hand out a
             grant. No permission ever reaches a token, and no other product asks this service what
             somebody may do — theirs stay local, exactly as before. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-access</artifactId>
            <version>${jmouse.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-access-enforcement</artifactId>
            <version>${jmouse.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-access-spring-boot</artifactId>
            <version>${jmouse.version}</version>
        </dependency>
        <!-- ⚠️ jmouse-access-jpa OWNS every access_* table, mapping included, and migrates them
             against a history table of its own — so Identity writes no @Entity over one and adds
             `org.jmouse.access.jpa.entity` to its @EntityScan. Forgetting that line starts cleanly
             and dies on the first query, because Hibernate validates only what it was given. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-access-jpa</artifactId>
            <version>${jmouse.version}</version>
        </dependency>
        <!-- The policy document — the grammar and the model it binds to.
             ⚠️ INERT UNTIL ID-3. The auto-configuration wakes up only when
             `jmouse.access.policy.locations` names something, and this service configures no
             locations yet, so no document is read and no seed runs. They are on the classpath now
             so that writing `policy/identity.jmp` is a file and two lines of yaml rather than a
             dependency change with a rebuild behind it. -->
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-access-policy</artifactId>
            <version>${jmouse.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jmouse</groupId>
            <artifactId>jmouse-access-el</artifactId>
            <version>${jmouse.version}</version>
        </dependency>

        <!-- Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- OpenAPI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Boilerplate reduction -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                        <configuration>
                            <additionalProperties>
                                <java.version>${java.version}</java.version>
                            </additionalProperties>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>get-git-info</id>
                        <goals><goal>revision</goal></goals>
                        <phase>initialize</phase>
                    </execution>
                </executions>
                <configuration>
                    <generateGitPropertiesFile>true</generateGitPropertiesFile>
                    <generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
                    <commitIdGenerationMode>full</commitIdGenerationMode>
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                    <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
                    <includeOnlyProperties>
                        <includeOnlyProperty>git.branch</includeOnlyProperty>
                        <includeOnlyProperty>git.commit.id.abbrev</includeOnlyProperty>
                        <includeOnlyProperty>git.commit.id</includeOnlyProperty>
                        <includeOnlyProperty>git.commit.time</includeOnlyProperty>
                        <includeOnlyProperty>git.commit.message.short</includeOnlyProperty>
                        <includeOnlyProperty>git.dirty</includeOnlyProperty>
                    </includeOnlyProperties>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- UI/vite.config.ts's own comment used to say "no frontend-maven-plugin" — reversed by
                 explicit request: running via `mvn spring-boot:run` on 9090 served whatever UI/dist
                 happened to exist from the last manual `npm run build`, which silently went stale
                 the moment you kept editing and only checked the Vite dev server (5175). Both goals
                 default-bind to generate-resources, which runs before compile — so by the time Boot
                 packages/serves static resources, UI/src/main/resources/static (Vite's own outDir)
                 is always freshly rebuilt from the current UI/src, on `mvn clean compile` and
                 `mvn spring-boot:run` alike. Node/npm versions pinned to what's already proven
                 working locally, downloaded into UI/node (gitignored) rather than relying on
                 whatever's globally installed. -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.1</version>
                <configuration>
                    <workingDirectory>../UI</workingDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>v24.15.0</nodeVersion>
                            <npmVersion>11.12.1</npmVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
